<idea-plugin>
    <depends>com.intellij.bigdatatools.core</depends>
    <depends>com.intellij.bigdatatools.rfs</depends>
    <depends>intellij.bigdatatools.awsBase</depends>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.github.linuxchina.locals3jbplugin.startup.CheckLocalS3Activity"/>
    </extensions>

    <applicationListeners>
        <listener class="com.github.linuxchina.locals3jbplugin.startup.SyncLocalS3ConnectionListener"
                  topic="com.github.linuxchina.locals3jbplugin.settings.LocalS3SettingsListener"/>
    </applicationListeners>

</idea-plugin>
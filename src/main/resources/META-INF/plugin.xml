<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin require-restart="true">
    <id>com.github.linuxchina.locals3</id>
    <name>Local S3</name>
    <vendor>linux_china</vendor>

    <depends>com.intellij.modules.platform</depends>

    <depends optional="true" config-file="locals3-bigdata.xml">com.intellij.bigdatatools.rfs</depends>
    <depends optional="true" config-file="locals3-json.xml">com.intellij.modules.json</depends>

    <resource-bundle>messages.LocalS3Bundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
        <notificationGroup id="Local S3 Notification" displayType="BALLOON" key="notification.group"/>
        <postStartupActivity implementation="com.github.linuxchina.locals3jbplugin.startup.StartLocalS3Activity"/>
        <applicationConfigurable
                id="com.github.linuxchina.locals3.settings"
                parentId="tools"
                key="settings.displayName"
                instance="com.github.linuxchina.locals3jbplugin.settings.LocalS3Configurable"/>
        <fileIconProvider implementation="com.github.linuxchina.locals3jbplugin.project.LocalS3ProjectConfigIconProvider"/>
        <statusBarWidgetFactory id="LocalS3"
                                implementation="com.github.linuxchina.locals3jbplugin.statusbar.LocalS3StatusBarWidgetFactory"/>
    </extensions>

    <actions>
        <group id="LocalS3.Actions" popup="true" icon="/icons/bucket-16.svg">
            <action id="LocalS3.Start" class="com.github.linuxchina.locals3jbplugin.actions.StartLocalS3Action"
                    icon="AllIcons.Actions.Execute"/>
            <action id="LocalS3.Stop" class="com.github.linuxchina.locals3jbplugin.actions.StopLocalS3Action"
                    icon="AllIcons.Actions.Suspend"/>
            <action id="LocalS3.Restart" class="com.github.linuxchina.locals3jbplugin.actions.RestartLocalS3Action"
                    icon="AllIcons.Actions.Restart"/>
            <separator/>
            <action id="LocalS3.OpenAdminUi" class="com.github.linuxchina.locals3jbplugin.actions.OpenLocalS3AdminUiAction"
                    icon="AllIcons.General.Web"/>
            <group id="LocalS3.CopyConnectionAs" popup="true" icon="AllIcons.Actions.Copy">
                <action id="LocalS3.CopyDotEnv" class="com.github.linuxchina.locals3jbplugin.actions.CopyLocalS3DotEnvAction"/>
                <action id="LocalS3.CopyOpenDal" class="com.github.linuxchina.locals3jbplugin.actions.CopyLocalS3OpenDalAction"/>
                <action id="LocalS3.CopyDuckDbSecret"
                        class="com.github.linuxchina.locals3jbplugin.actions.CopyLocalS3DuckDbSecretAction"/>
                <action id="LocalS3.CopySpringBootProperties"
                        class="com.github.linuxchina.locals3jbplugin.actions.CopyLocalS3SpringBootPropertiesAction"/>
                <action id="LocalS3.CopyAwsCliProfile"
                        class="com.github.linuxchina.locals3jbplugin.actions.CopyLocalS3AwsCliProfileAction"/>
                <separator/>
                <action id="LocalS3.CopyPyIcebergConfig"
                        class="com.github.linuxchina.locals3jbplugin.actions.CopyLocalS3PyIcebergConfigAction"/>
                <action id="LocalS3.CopySparkIcebergProperties"
                        class="com.github.linuxchina.locals3jbplugin.actions.CopyLocalS3SparkIcebergPropertiesAction"/>
                <action id="LocalS3.CopyDuckDbIcebergAttach"
                        class="com.github.linuxchina.locals3jbplugin.actions.CopyLocalS3DuckDbIcebergAttachAction"/>
            </group>
            <separator/>
            <action id="LocalS3.OpenSettings" class="com.github.linuxchina.locals3jbplugin.actions.OpenLocalS3SettingsAction"
                    icon="AllIcons.General.Settings"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
        <action id="LocalS3.SyncProjectConfig" class="com.github.linuxchina.locals3jbplugin.actions.SyncLocalS3ProjectConfigAction"
                icon="AllIcons.Actions.Refresh">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
